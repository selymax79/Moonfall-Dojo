; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Moonfall Dojo"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/stretch/mode="viewport"
window/stretch/aspect="keep"
window/stretch/scale_mode="fractional"

[input]

dev_restart={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194333)]
}

jump={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194320)]
}

duck={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194322)]
}

kick={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":88)]
}

punch={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":90)]
}

turn_left={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194319)]
}
turn_right={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194321)]
}

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.035, 0.045, 0.08, 1)
rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
